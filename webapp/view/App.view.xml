<mvc:View
    controllerName="novamart.inventoryportal.inventoryportal.controller.App"
    displayBlock="true"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f">
    <f:FlexibleColumnLayout
        id="fcl"
        layout="{appView>/layout}"
        backgroundDesign="Translucent"
        busy="{appView>/busy}"
        busyIndicatorDelay="{appView>/delay}">
    </f:FlexibleColumnLayout>
</mvc:View>